# Réglages de compose.yaml pour un poste (Linux, macOS, Windows). Copier ce
# fichier en .env, à côté de compose.yaml :
#   cp .env.local.example .env
# Facultatif : sans .env, compose.yaml prend déjà ces valeurs.

# Pilote de logs Docker du site : `local`, disponible partout (Docker Desktop
# n'a pas journald).
LOG_DRIVER=local
